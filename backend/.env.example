# Copy this file to .env (never commit .env)
DATABASE_URL=sqlite:///./fraud.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----- Security -------------------------------------------------------
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
# Leave blank to disable auth in dev mode (NOT safe for production).
API_KEY=

# Comma-separated list of allowed Host headers (prevents host-injection attacks).
ALLOWED_HOSTS=localhost,127.0.0.1

# Maximum accepted request body size in bytes (default: 65536 = 64 KB).
MAX_BODY_BYTES=65536

# Only Member 4's notification module needs these
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
